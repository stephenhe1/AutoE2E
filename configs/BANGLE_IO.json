{
  "temp_dir": "./tmp",
  "driver": {
    "base_url": "http://127.0.0.1:5173/"
  },
  "browser": {
    "headless": true,
    "detach": false
  },
  "crawl": {
    "max_actions": 100,
    "max_states": 100,
    "max_wall_seconds": 3600
  },
  "llm": {
    "request_timeout_seconds": 120,
    "max_retries": 1
  },
  "lifecycle": {
    "on_visit": [
      [
        "autoe2e",
        "ClientState",
        {
          "baseline": "harness/state/bangle-io-baseline.json"
        }
      ]
    ],
    "on_state_discovery": []
  }
}
