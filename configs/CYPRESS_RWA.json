      [
        "autoe2e",
        "FormLogin",
        {
          "url": "/signin",
          "username_selector": "#username",
          "password_selector": "#password",
          "submit_selector": "form button[type=submit]",
          "username": "Heath93",
          "password": "s3cret",
          "success_url_excludes": "/signin"
        }
      ]
    ],
    "on_state_discovery": []
  }
}
